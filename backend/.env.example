# Copy to backend/.env and fill in. Never commit .env.
# Leave SUPABASE_* empty to run in DEMO mode: in-memory data + demo login, no database needed.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional: if set, tokens are verified locally (HS256 legacy secret). If empty, they are checked with Supabase Auth.
SUPABASE_JWT_SECRET=

# Leave empty to use the built-in canned replies (no AI).
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3

# Leave empty to print alert emails in the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

FRONTEND_ORIGIN=http://localhost:5173

# Test page at http://localhost:8000/dev (no accounts needed). Set to false on any public server.
DEV_TOOLS=true
